ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# Optional. Defaults to 12 hours.
ADMIN_SESSION_MAX_AGE_SECONDS=43200

# Vercel Blob. Production usually gets BLOB_STORE_ID from the connected Blob store.
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
# Optional legacy Blob auth token.
BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token

# Optional. Defaults to cms/products.json.
CMS_PRODUCTS_BLOB_PATH=cms/products.json
